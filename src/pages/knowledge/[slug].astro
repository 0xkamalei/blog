---
import Layout from '../../layouts/Layout.astro';
import { getKnowledgeEntries } from '../../lib/knowledge';

export async function getStaticPaths() {
	return getKnowledgeEntries().map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<Layout
	title={entry.title}
	description={entry.description}
	wide={true}
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</Fragment>

	<div class="kb-page">
		<nav class="kb-breadcrumb" aria-label="面包屑">
			<a href="/knowledge/">← 知识</a>
			{entry.tags.length > 0 && (
				<div class="kb-tags">
					{entry.tags.map((tag) => <span class="kb-tag">#{tag}</span>)}
				</div>
			)}
		</nav>

		<!-- 声明式 Shadow DOM：知识页自带样式被完全隔离，不影响站点全局样式 -->
		<div class="kb-canvas" set:html={entry.shadowHtml}></div>

		<footer class="kb-footer">
			<a href="/knowledge/">← 返回知识列表</a>
		</footer>
	</div>
</Layout>

<style>
	.kb-page {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.kb-breadcrumb {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.kb-breadcrumb a {
		font-size: 0.875rem;
		color: var(--text-secondary);
		text-decoration: none;
		padding: 0.375rem 0.625rem;
		margin-left: -0.625rem;
		border-radius: 6px;
		transition: all 0.15s ease;
	}

	.kb-breadcrumb a:hover {
		color: var(--text-color);
		background-color: var(--hover-color);
	}

	.kb-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.kb-tag {
		color: var(--accent-color);
		background-color: rgba(139, 92, 246, 0.1);
		padding: 0.125rem 0.5rem;
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 500;
	}

	.kb-canvas {
		background-color: #020617;
		border: 1px solid var(--border-color);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: var(--shadow-lg);
	}

	.kb-footer {
		margin-top: 1rem;
		display: flex;
	}

	.kb-footer a {
		font-size: 0.875rem;
		color: var(--text-secondary);
		text-decoration: none;
		padding: 0.625rem 1rem;
		border-radius: 8px;
		background-color: var(--hover-color);
		transition: all 0.15s ease;
	}

	.kb-footer a:hover {
		color: var(--text-color);
		border-color: var(--primary-color);
	}

	@media (max-width: 640px) {
		.kb-canvas {
			border-radius: 12px;
		}
	}
</style>
